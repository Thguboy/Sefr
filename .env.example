# Copy this file to .env and fill in the values
# PythonAnywhere: set these in Web tab → Environment variables

# Flask secret key — change this to a long random string!
SECRET_KEY=change-me-to-a-long-random-secret-key

# ElevenLabs API key for Text-to-Speech (optional)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
